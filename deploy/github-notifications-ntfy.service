[Unit]
Description=Forward new GitHub notifications to ntfy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/github-notifications-ntfy.env
# ProtectHome hides home directories, so bun must live outside them (see README).
ExecStart=/usr/local/bin/bun /opt/github-notifications-ntfy/src/main.ts
TimeoutStartSec=50
StateDirectory=github-notifications-ntfy
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
